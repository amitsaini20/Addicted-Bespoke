{{ 'ss-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign sid = 'ssf-' | append: section.id
-%}

<section
  id="{{ sid }}"
  class="ssf"
  style="
    --ssf-bg: {{ section.settings.bg }};
    --ssf-text: {{ section.settings.text }};
    --ssf-accent: {{ section.settings.accent }};
    --ssf-ratio: {{ section.settings.ratio }};
  "
  {{ section.shopify_attributes }}
>
  <div class="ssf__wrap">

    <header class="ssf__head">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="ssf__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="ssf__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if collection != blank and section.settings.view_all_label != blank -%}
        <a class="ssf__all ssf__all--top" href="{{ collection.url }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      {%- endif -%}
    </header>

    {%- if collection != blank -%}
      <ul class="ssf__grid">
        {%- for product in collection.products limit: section.settings.count -%}
          <li class="ssf__item">
            <a class="ssf__card" href="{{ product.url }}">

              <span class="ssf__media">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 480, 600',
                      sizes: '(min-width: 1100px) 262px, (min-width: 750px) 25vw, 50vw',
                      alt: product.featured_image.alt,
                      class: 'ssf__img'
                  }}
                {%- else -%}
                  <span class="ssf__ph"></span>
                {%- endif -%}

                {%- unless product.available -%}
                  <span class="ssf__badge">{{ section.settings.soldout_label | escape }}</span>
                {%- endunless -%}
              </span>

              <span class="ssf__info">
                <span class="ssf__name">{{ product.title | escape }}</span>

                <span class="ssf__price">
                  {%- if product.compare_at_price > product.price -%}
                    <s>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}

                  {%- if product.price_varies -%}
                    {{ section.settings.from_label | escape }}
                  {%- endif %}
                  {{ product.price | money }}
                </span>
              </span>

            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.view_all_label != blank -%}
        <p class="ssf__foot">
          <a class="ssf__all" href="{{ collection.url }}">
            {{ section.settings.view_all_label | escape }}
          </a>
        </p>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

<style>
  #{{ sid }} {
    padding: clamp(40px, 7vw, 80px) 16px;
    background: var(--ssf-bg);
    color: var(--ssf-text);
  }

  #{{ sid }} .ssf__wrap {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Header */
  #{{ sid }} .ssf__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  #{{ sid }} .ssf__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 3.6vw, 36px);
    font-weight: 400;
    line-height: 1.15;
  }

  #{{ sid }} .ssf__sub {
    max-width: 52ch;
    margin: 0.5em 0 0;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.75;
  }

  /* Product grid: 2 columns on mobile, 4 on desktop */
  #{{ sid }} .ssf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #{{ sid }} .ssf__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #{{ sid }} .ssf__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  /* Image */
  #{{ sid }} .ssf__media {
    position: relative;
    display: block;
    aspect-ratio: var(--ssf-ratio);
    overflow: hidden;
    background: #ebe9e4;
  }

  #{{ sid }} .ssf__img,
  #{{ sid }} .ssf__ph {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ sid }} .ssf__img {
    transition: transform 0.5s ease;
  }

  #{{ sid }} .ssf__card:hover .ssf__img {
    transform: scale(1.04);
  }

  #{{ sid }} .ssf__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    background: #fff;
    color: #14171f;
    font-size: 12px;
  }

  /* Title and price */
  #{{ sid }} .ssf__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 10px;
  }

  #{{ sid }} .ssf__name {
    font-size: 15px;
    line-height: 1.35;
  }

  #{{ sid }} .ssf__price {
    font-size: 14px;
    opacity: 0.75;
  }

  #{{ sid }} .ssf__price s {
    margin-right: 6px;
    opacity: 0.7;
  }

  /* View all button */
  #{{ sid }} .ssf__all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 24px;
    border: 1px solid currentColor;
    color: inherit;
    font-size: 15px;
    text-decoration: none;
  }

  #{{ sid }} .ssf__all:hover {
    border-color: var(--ssf-accent);
    background: var(--ssf-accent);
    color: #fff;
  }

  #{{ sid }} .ssf__all--top {
    display: none;
  }

  #{{ sid }} .ssf__foot {
    margin: 28px 0 0;
    text-align: center;
  }

  @media (min-width: 750px) {
    #{{ sid }} .ssf__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px 20px;
    }

    #{{ sid }} .ssf__all--top {
      display: inline-flex;
    }

    #{{ sid }} .ssf__foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ sid }} .ssf__img {
      transition: none;
    }

    #{{ sid }} .ssf__card:hover .ssf__img {
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "SS Featured suits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with a favourite"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pieces our clients choose most often. Every one is made to your measurements."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Tall portrait (3:4)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "Label for varying prices",
      "default": "From"
    },
    {
      "type": "text",
      "id": "soldout_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button label",
      "info": "Leave empty to hide the button.",
      "default": "View all"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f7f6f3"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#14171f"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Button hover color",
      "default": "#8c6d3f"
    }
  ],
  "presets": [
    {
      "name": "SS Featured suits"
    }
  ]
}
{% endschema %}